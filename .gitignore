# ============================================================
# Roamly — Complete Travel Bundle (.gitignore)
# Generated for professional GitHub publishing
# ============================================================

# ✅ Python bytecode cache
__pycache__/
*.py[cod]
*$py.class

# ✅ Virtual environments (never commit)
venv/
.env/
.venv/

# ✅ Environment variables & API secrets (NEVER commit these!)
.env
.env.*
!.env.example

# ✅ Generated runtime data
data/trips.json
data/social.json
data/group_photos/

# ✅ Python distribution / packaging
dist/
build/
*.egg-info/

# ✅ IPython / Jupyter cache
# (handled by __pycache__/ above)

# ✅ Local Firebase web configuration
web/.env.local
web/.env.*.local

# ✅ Node / Vite build artifacts
web/node_modules/
web/dist/

# ✅ React / Vite public output (build-generated, not source)
web/public/

# ✅ Database files (never commit — contains credentials etc)
*.db
*.sqlite
*.sqlite3

# ✅ Test / coverage artifacts
.hcov/
.coverage

# ✅ Lint / format outputs
.prettier.json
eslint.cache.js

# ✅ Security - never commit these (API keys, secrets, tokens)
secrets.json
keys.json
config*.json
*.key
*.pem
*.crt
*.cert

# ✅ Operating system junk
.DS_Store
Thumbs.db

# ============================================================
# End of .gitignore
# ============================================================